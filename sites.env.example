# Opis testnih stranica za bin/deploy.sh, bin/measure.sh, testove stvarnim HTTP-om i tests/tools/*.
# Kopirati u ~/.config/bulkbird-helper/sites.env (dozvole 600, izvan repozitorija) i upisati stvarne vrijednosti.
# Druga putanja: varijabla BBH_SITES_FILE. Varijabla postavljena u okolini ima prednost pred datotekom.
# Ovdje su izmišljene vrijednosti. Tajne (ključevi, lozinke) NE idu u ovu datoteku, nego u test.env.
#
# NEW = stranica s najnovijim verzijama, OLD = stranica s najnižim podržanim verzijama.
#   _SSH         SSH alias stranice; prazno ako je stranica pod istim korisnikom kao radna kopija
#   _HOME        početna mapa korisnika stranice (ispod nje su htdocs/<HOST>, backups/, logs/, tmp/)
#   _HOST        naziv hosta trgovine, bez https://
#   _WPCLI       puna putanja omotača WP-CLI-ja koji koristi isti PHP kao web
#   _LOGS        logovi PHP-a i WordPressa (razmakom odvojeni)
#   _ACCESS_LOG  zapisi web servera (smije sadržavati * za rotirane datoteke)
BBH_SITE_NEW_SSH=
BBH_SITE_NEW_HOME=/home/example-new
BBH_SITE_NEW_HOST=new.example.com
BBH_SITE_NEW_WPCLI=/home/example-new/bin/wp
BBH_SITE_NEW_LOGS=/home/example-new/logs/wp-debug.log /home/example-new/logs/php/error.log
BBH_SITE_NEW_ACCESS_LOG=/home/example-new/logs/nginx/access.log*

BBH_SITE_OLD_SSH=example-old
BBH_SITE_OLD_HOME=/home/example-old
BBH_SITE_OLD_HOST=old.example.com
BBH_SITE_OLD_WPCLI=/home/example-old/bin/wp
BBH_SITE_OLD_LOGS=/home/example-old/logs/php/error.log /home/example-old/logs/wp-debug.log
BBH_SITE_OLD_ACCESS_LOG=/home/example-old/logs/nginx/access.log*

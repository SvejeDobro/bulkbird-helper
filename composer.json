{
    "name": "bulkbird/bulkbird-helper",
    "description": "Optional WooCommerce companion plugin for the Bulkbird desktop app.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
        "php-stubs/woocommerce-stubs": "^8.0 || ^9.0 || ^10.0"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "unit": "phpunit --testsuite unit",
        "guards": "bin/check-guards.sh",
        "build": "bin/build-zip.sh",
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@unit",
            "@guards"
        ],
        "e2e": "phpunit --testsuite e2e",
        "faults": "bin/run-faults.sh"
    }
}
